# Server
NODE_ENV=development
PORT=3000

# Database (TypeORM / PostgreSQL). docker-compose.yml reads DB_PORT, DB_USER and DB_NAME.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=prime_sweets

# Alegra
ALEGRA_BASE_URL=https://api.alegra.com/api/v1
ALEGRA_TOKEN=
ALEGRA_PRICE_LIST_MAJOR_ID=1
ALEGRA_PRICE_LIST_MINOR_ID=

# Company profile used only to render an invoice. Supply the business values; do not invent them.
COMPANY_NAME=
COMPANY_NIT=
COMPANY_CITY=
COMPANY_COUNTRY=
COMPANY_TELEPHONE=
COMPANY_LOGO=
COMPANY_LEGAL_TEXT=
