# Server
NODE_ENV=development
PORT=3000

# Postgres. The API reads DATABASE_URL. Migrations prefer DATABASE_URL_UNPOOLED.
# Local:
# DATABASE_URL=postgresql://postgres@127.0.0.1:5432/prime_sweets?sslmode=disable
# DATABASE_URL_UNPOOLED=postgresql://postgres@127.0.0.1:5432/prime_sweets?sslmode=disable
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Alegra. ALEGRA_TOKEN is the Basic credential already encoded. Do not commit a real token.
ALEGRA_BASE_URL=https://api.alegra.com/api/v1
ALEGRA_TOKEN=
ALEGRA_PRICE_LIST_MAJOR_ID=1
ALEGRA_PRICE_LIST_MINOR_ID=

# Company profile used only to render an invoice. Supply the business values; do not invent them.
COMPANY_NAME=
COMPANY_NIT=
COMPANY_CITY=
COMPANY_COUNTRY=
COMPANY_TELEPHONE=
COMPANY_LOGO=/company/logo.svg
COMPANY_LEGAL_TEXT=
