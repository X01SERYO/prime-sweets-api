{
  "name": "prime-sweets-api",
  "version": "1.0.0",
  "description": "Core backend API for Dulcería La Principal (Prime Sweets)",
  "main": "dist/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "test": "node --test \"dist/**/*.test.js\"",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "node dist/index.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm-ts-node-commonjs -d src/shared/infrastructure/persistence/typeorm/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/shared/infrastructure/persistence/typeorm/data-source.ts migration:revert",
    "migration:show": "typeorm-ts-node-commonjs -d src/shared/infrastructure/persistence/typeorm/data-source.ts migration:show"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "node-dependency-injection": "^3.2.6",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
