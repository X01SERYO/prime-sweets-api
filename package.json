{
  "name": "prime-sweets-api",
  "version": "1.0.0",
  "description": "Core backend API for Dulcería La Principal (Prime Sweets)",
  "main": "dist/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "test": "node --test \"dist/test/**/*.test.js\"",
    "test:coverage": "c8 --all --include \"dist/**/*.js\" --exclude \"dist/test/**\" --reporter text-summary --reporter json-summary node --test \"dist/test/**/*.test.js\"",
    "test:unit": "node --test \"dist/test/unit/**/*.test.js\"",
    "test:integration": "node --test \"dist/test/integration/**/*.test.js\"",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/shared/infrastructure/persistence/typeorm/data-source.ts migration:run",
    "migration:revert": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/shared/infrastructure/persistence/typeorm/data-source.ts migration:revert",
    "migration:show": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/shared/infrastructure/persistence/typeorm/data-source.ts migration:show"
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "node-dependency-injection": "^3.2.6",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "globals": "^16.4.0",
    "prettier": "^3.2.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
