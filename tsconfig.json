{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],

    "module": "CommonJS",
    "moduleResolution": "node10",
    // node10 keeps extensionless imports in the CommonJS output.
    // bundler cannot emit CommonJS. nodenext would require a .js suffix.
    // TypeScript 6 deprecates node10; this keeps it until TypeScript 7.
    "ignoreDeprecations": "6.0",

    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "esModuleInterop": true,
    "types": ["node"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
