{
  "compilerOptions": {
    "target": "ES2022",
    // JavaScript version emitted by TypeScript.
    // ES2022 matches the baseline of Node 22.

    "module": "CommonJS",
    // Module system used in the output JavaScript.
    // CommonJS is the native module system for Node.js.

    "moduleResolution": "node10",
    // Classic Node resolution for CommonJS (the old "node" setting).
    // "nodenext" would require file extensions on every relative import.
    // ignoreDeprecations "6.0" is valid only on TypeScript 6; this project compiles with 5.9.

    "outDir": "dist",
    // Directory where compiled JavaScript files are emitted.

    "rootDir": "src",
    // Root directory of the TypeScript source code.

    "strict": true,
    // Enables all strict type-checking options.
    // Critical for business rules and domain safety.

    "noImplicitAny": true,
    // Disallows variables and parameters with implicit `any` type.

    "strictNullChecks": true,
    // Forces explicit handling of null and undefined values.
    // Prevents many runtime errors.

    "forceConsistentCasingInFileNames": true,
    // Ensures consistent file name casing across different OS (Windows/Linux).

    "skipLibCheck": true,
    // Skips type checking of declaration files in node_modules.
    // Improves build performance without sacrificing safety.

    "experimentalDecorators": true,
    // Enables decorators support.
    // Required by TypeORM and some DDD patterns.

    "emitDecoratorMetadata": true,
    // Emits metadata for decorators.
    // Needed for dependency injection and ORM reflection.

    "sourceMap": true,
    // Generates source maps for better debugging experience.

    "esModuleInterop": true,
    // Enables compatibility with CommonJS and ES modules.
  },
  "include": ["src/**/*.ts"],
  // Includes all TypeScript files under the src directory

  "exclude": ["node_modules", "dist"]
  // Excludes dependencies and compiled output
}
